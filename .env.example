# URL del backend (Django). En producción same-origin (proxy /api y /media)
# normalmente no hace falta definirla. Para desarrollo local o API en otro origen
# (ej. frontend en Netlify y backend en Railway):
VITE_API_URL=http://127.0.0.1:8001

# Ruta base del build. '/' para sitio en raíz (Netlify). '/admin/' para subruta.
VITE_BASE=/

# Opcionales: OAuth
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
